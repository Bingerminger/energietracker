# Energietracker — Apache-Konfiguration (Synology Web Station, DSM)
#
# v2.3.1: ausschließlich Cache-Steuerung.
#
# Anwendungscode und Sprachkataloge tragen seit v2.3.1 eine Version im Pfad
# (Import-Map in index.php). Das genügt für jeden Browser, der Import-Maps
# unterstützt. Diese Regel ist die zweite Absicherung: Sie zwingt auch ohne
# Import-Map zur Revalidierung — mit ETag kostet das ein 304 und ein paar
# Byte, kein erneutes Übertragen.
#
# Anlass: Nach dem v2.3.0-Update lieferte Safari eine gecachte `api.js` ohne
# `tariffSwitch` aus, obwohl der Server längst die neue Datei hatte. Prod
# sendete für Module überhaupt kein `Cache-Control`, nur ETag und
# Last-Modified — der Browser durfte also heuristisch cachen.
#
# ⚠ Diese Datei enthält BEWUSST noch keine Zugriffsregeln für data/, src/,
#   .git/ und tests/. Der Schutz dieser Pfade ist als eigenes Patch-Release
#   terminiert und wird hier ergänzt, wenn es soweit ist.

<IfModule mod_headers.c>
  # Anwendungscode und Kataloge: immer revalidieren.
  <FilesMatch "\.(js|mjs|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Die Shell darf ebenfalls nicht aus dem Cache kommen — sie trägt die
  # Import-Map, und eine veraltete Map verweist auf veraltete Module.
  <FilesMatch "^(index\.php|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Schriften und das Chart-Bundle sind versioniert eingebunden und ändern
  # sich praktisch nie — die dürfen lange liegen bleiben.
  <FilesMatch "\.(woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
